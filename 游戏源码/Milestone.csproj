<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>Milestone</AssemblyName>
    <RootNamespace>ChartPlayer</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>4.0.0</Version>

    <!-- t62 四目录迁移：OutputPath 指向 输出产物\bin（游戏源码\..\输出产物\bin）；$(Configuration) 保 Release\net8.0-windows\win-x64 传统子路径（captain 构建/取证沿用） -->
    <OutputPath>..\输出产物\bin\$(Configuration)\</OutputPath>

    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
  <PropertyGroup>
    <!-- 引擎源码必须位于本仓库之外；引擎仅作为构建依赖使用。 -->
    <EngineV2Source Condition="'$(EngineV2Source)' == '' and '$(ENGINE_V2_SOURCE)' != ''">$(ENGINE_V2_SOURCE)</EngineV2Source>
    <EngineV2Source Condition="'$(EngineV2Source)' == ''">..\..\_engine-source-canonical\legacy-v2\引擎源码\engine</EngineV2Source>
  </PropertyGroup>
  <Target Name="ForbidEngineSourceInsideMilestoneRepo" BeforeTargets="BeforeBuild">
    <Error Condition="Exists('$(MSBuildProjectDirectory)\..\引擎源码')" Text="引擎源码禁止进入 Milestone 仓库：请把引擎源码放在仓库外，通过 EngineV2Source / ENGINE_V2_SOURCE 引用。" />
  </Target>
  <Target Name="RequireExternalEngineV2" BeforeTargets="BeforeBuild" Condition="!Exists('$(EngineV2Source)\MilestoneEngine.csproj')">
    <Error Text="未找到外部引擎源码：$(EngineV2Source)。Milestone 仓库不得包含引擎源码；请设置 ENGINE_V2_SOURCE。" />
  </Target>
  <ItemGroup>
    <!-- Direct2D 硬件加速渲染（GPU） -->
    <PackageReference Include="SharpDX" Version="4.2.0" />
    <PackageReference Include="SharpDX.Direct2D1" Version="4.2.0" />
    <PackageReference Include="SharpDX.DXGI" Version="4.2.0" />
    <PackageReference Include="SharpDX.Mathematics" Version="4.2.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- t62 四目录迁移：源码=本工程内 源码\（SDK 自动包含）；引擎=仓库外 EngineV2Source（ProjectReference）；
         其他/构建产物/编辑指南/输出产物 均在工程外，无需排除 -->
    <Compile Remove="obj\**" />
  </ItemGroup>
  <ItemGroup>
    <!-- 引擎示例/演示由仓库外 EngineV2Source 编译进游戏（DemoRunner/MiniManiaForm/EngineGame 等由游戏层引用） -->
    <Compile Include="$(EngineV2Source)\Samples\**\*.cs" Condition="Exists('$(EngineV2Source)\Samples')" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(EngineV2Source)\MilestoneEngine.csproj" Condition="Exists('$(EngineV2Source)\MilestoneEngine.csproj')" />
  </ItemGroup>
</Project>